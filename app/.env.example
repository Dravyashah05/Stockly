# Stockly user frontend — PUBLIC config only. No secrets here.
# Web dev builds use same-origin (Vite proxies /api/* to the shared backend).
# Installed Android builds have no same-origin server, so they need the
# deployed backend origin (public origin only — never secrets).

# Shared backend origin for Android builds, e.g. https://your-app.vercel.app
# Leave empty for web dev (Vite proxy handles /api/*).
VITE_API_BASE_URL=http://localhost:5000

# Owner console URL linked from Settings → Administration (separate frontend,
# same shared backend). Dev default below; production: your admin site URL.
VITE_ADMIN_URL=http://localhost:3002
