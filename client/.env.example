# ==============================================================================
# Stockly Client Configuration Template (.env.example)
#
# Vite inlines VITE_* environment variables at build time.
# Copy this file to `client/.env` before running `npm run build`.
# ==============================================================================

# Backend API Base URL
# Development: http://localhost:5000/api
# Production (Split deploy): https://your-backend-api.onrender.com/api
# Production (Single service): /api
VITE_API_URL=http://localhost:5000/api
