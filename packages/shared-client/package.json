    "./users": "./src/users.ts",
    "./connection": "./src/connection.ts",
    "./releases": "./src/releases.ts",
    "./admin-api": "./src/admin-api.ts"
  },
  "scripts": {
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@stockly/shared-types": "*",
