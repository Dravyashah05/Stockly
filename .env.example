# ============================================================================
# Stockly — single root environment file (the ONLY local .env file)
# ============================================================================
# Copy to `.env` (never commit `.env`; `.env.example` is safe to commit).
# Loaded by:
#   - the backend  (server/src/env.ts via dotenv, path anchored to this repo)
#   - the website  (apps/website/vite.config.ts via envDir, cwd-independent)
#   - the mobile app (apps/mobile/vite.config.ts via envDir, cwd-independent)
#   - Capacitor config (root capacitor.config.ts — non-secret switches only)
#
# SECURITY RULE: only variables prefixed `VITE_` are visible to frontend
# code. Everything else stays in Node. A build fails if a VITE_ variable
# looks like a secret (…SECRET / …TOKEN / …KEY / …PASSWORD).

# ----------------------------------------------------------------------------
# Public frontend configuration (safe to commit — no secrets here)
# ----------------------------------------------------------------------------

# Backend origin for INSTALLED Android builds (native has no same-origin
# server). Must be a plain origin: the app appends /api/* to it.
# Web builds leave this empty (same-origin via the dev proxy / deployment).
# For a local backend in the Android emulator use http://10.0.2.2:5000
# together with STOCKLY_LOCAL_API=1 (see capacitor.config.ts + docs/android.md).
VITE_API_BASE_URL=https://stocklybydns.vercel.app

# Optional public default Apps Script web-app URL (legacy setup fallback).
# The per-user sheet URL is normally stored server-side after connection.
VITE_USER_SCRIPT_URL=

# Website URL of the owner console, opened from the mobile app's Settings.
# (The website hosts it at #/admin; leave empty on same-origin web builds.)
VITE_ADMIN_URL=https://stocklybydns.vercel.app/#/admin

# ----------------------------------------------------------------------------
# Backend / server (server/src/env.ts validates these at startup; NEVER
# VITE_-prefixed, never printed to logs)
# ----------------------------------------------------------------------------

# HTTP port of the shared Express backend (also used as the frontend dev
# proxy target).
PORT=5000
NODE_ENV=development

# Private admin Google Apps Script web app (Admin.gs) + shared token.
ADMIN_SCRIPT_URL=
ADMIN_SCRIPT_TOKEN=

# One-time key that bootstraps the first owner account.
ADMIN_SETUP_KEY=

# HMAC session/signing secrets (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
ADMIN_SESSION_SECRET=
ADMIN_MIRROR_SECRET=
AUTH_SESSION_SECRET=
DEVICE_SESSION_SECRET=

# Admin session lifetime in hours (optional; default 12).
ADMIN_SESSION_TTL_HOURS=12

# ----------------------------------------------------------------------------
# Local-only switches (never deploy these)
# ----------------------------------------------------------------------------

# Set to 1 when the Android emulator must reach a backend on the host
# machine (http://10.0.2.2:PORT). Allows cleartext + http scheme in
# capacitor.config.ts. NEVER set this for production builds.
# STOCKLY_LOCAL_API=1
