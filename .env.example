# Public frontend configuration (safe to commit — no secrets here).
# The browser may use ONLY these: a public Apps Script URL fallback and the
# backend origin for installed Android builds (origins are public).

VITE_USER_SCRIPT_URL=
# Backend origin for installed Android builds (no same-origin server there).
# Web builds leave this empty (same-origin). Example:
# VITE_API_BASE_URL=https://your-app.vercel.app
VITE_API_BASE_URL=https://stocklybydns.vercel.app/app.html

# --- Server-side only (Vercel → Settings → Environment Variables; NEVER
# --- VITE_* prefixed, never committed with real values). See
# --- docs/admin-setup.md, docs/device-linking.md and docs/auth-setup.md.
# ADMIN_SCRIPT_URL=
# ADMIN_SCRIPT_TOKEN=
# ADMIN_SETUP_KEY=
# ADMIN_SESSION_SECRET=
# ADMIN_MIRROR_SECRET=
# DEVICE_SESSION_SECRET=
# AUTH_SESSION_SECRET=
# ADMIN_SESSION_TTL_HOURS=12
