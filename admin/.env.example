# Stockly owner console — PUBLIC config only. No secrets here.
# Web builds use same-origin (Vite proxies /api/* to the shared backend).
# Only origins belong here — the private admin spreadsheet credentials stay
# server-side (server/.env), and the owner session token lives in
# sessionStorage, never in env files.

# Shared backend origin (only needed for non-same-origin builds).
# Leave empty for local dev (Vite proxy handles /api/*).
VITE_API_BASE_URL=
