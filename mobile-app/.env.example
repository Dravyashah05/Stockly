# Stockly user frontend — PUBLIC config only. No secrets here.
# Web dev builds use same-origin (Vite proxies /api/* to the shared backend).
# Installed Android builds have no same-origin server, so they need the
# deployed backend origin (public origin only — never secrets).

# Shared backend origin for installed Android builds, e.g.
# https://api.your-domain.example. Set the real public origin before building.
# Leave empty for web dev (Vite proxy handles /api/*).
#
# SAME-WIFI TESTING (no deployment needed):
# 1. Phone + PC on the same WiFi. PC's LAN IP (e.g. 192.168.1.2 — it can
#    change with DHCP, re-check with `ipconfig` if sync stops working).
# 2. Copy this file to `.env` and set:
#      VITE_API_BASE_URL=http://192.168.1.2:5000
# 3. `npm run android:build`, reinstall the APK.
# 4. Allow inbound TCP 5000 in Windows Firewall (run as admin):
#      New-NetFirewallRule -DisplayName 'Stockly server' -Direction Inbound -Protocol TCP -LocalPort 5000 -Action Allow
# capacitor.config.ts reads this file at sync time and switches the WebView
# to http+cleartext automatically for http:// URLs (https:// stays locked down).
VITE_API_BASE_URL=

# Owner console URL linked from Settings → Administration (separate frontend,
# same shared backend). Dev default below; production: your admin site URL.
VITE_ADMIN_URL=http://localhost:3002
