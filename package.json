{
  "name": "stockly",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Stockly - Mobile stock management for small business",
  "scripts": {
    "dev": "vite",
    "dev:app": "vite --open app.html",
    "dev:mobile": "npm --prefix mobile-app run dev",
    "dev:website": "npm --prefix website run dev",
    "dev:user": "npm --prefix mobile-app run dev",
    "dev:admin": "npm --prefix admin run dev",
    "dev:server": "npm --prefix server run dev",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "tsc -b && vite build",
    "build:app": "npm --prefix mobile-app run build",
    "build:mobile": "npm --prefix mobile-app run build",
    "build:web": "tsc -b && vite build --config vite.config.web.ts",
    "build:website": "npm --prefix website run build",
    "build:user": "npm --prefix mobile-app run build",
    "build:admin": "npm --prefix admin run build",
    "lint": "oxlint",
    "test": "node --experimental-strip-types --test tests/api-response.test.ts tests/releases.test.ts tests/user-registry.test.ts tests/admin-auth.test.ts tests/device-link.test.ts tests/auth.test.ts tests/server.test.ts",
    "preview": "vite preview",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android",
    "android:build": "npm run build:mobile && npm run cap:sync"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.554.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-qr-code": "^2.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "vite": "^8.3.0"
  }
}
