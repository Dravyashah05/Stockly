PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/stock_management?retryWrites=true&w=majority
CLIENT_URL=https://your-frontend.vercel.app,http://localhost:5173
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING_GENERATE_via_openssl_rand_base64_32
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Optional: CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
