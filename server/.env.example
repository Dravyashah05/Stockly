# ==============================================================================
# Stockly Server Configuration Template (.env.example)
#
# IMPORTANT: Copy this file to `server/.env` and update the values.
# NEVER commit your actual `server/.env` file to any public or private git repository!
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=production

# MongoDB Database Connection String (Atlas Replica Set or Local MongoDB)
# Replace USERNAME, PASSWORD, and CLUSTER with your actual MongoDB Atlas credentials.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/stockly_inventory?retryWrites=true&w=majority

# CORS Whitelist (Comma-separated list of allowed frontend origins)
# In production, set this to your exact Vercel / custom frontend URL.
CLIENT_URL=https://your-frontend.vercel.app,http://localhost:5173

# JWT Secret Key for Session Authentication
# Must be at least 32 characters in production. Generate a strong key with:
#   openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_KEY_MINIMUM_32_CHARACTERS

# Cloudinary Storage Credentials (Optional: for cloud product image hosting)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Opencode / OpenRouter / AI Intelligence (Optional: fallback defaults for server)
# Can also be dynamically configured per user in the Settings UI.
OPENCODE_API_KEY=your_opencode_or_openrouter_api_key
OPENCODE_BASE_URL=https://api.opencode.ai/v1
OPENCODE_MODEL=deepseek/deepseek-chat
