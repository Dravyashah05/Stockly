# Stockly shared backend — PRIVATE, server-side only. Never commit with real values.
# Copy to server/.env (local dev). Production: set these in the host's env panel.
# Frontends must NEVER read these (no VITE_* prefix here).

PORT=5000

# Exact browser origins permitted to call the API directly (comma-separated).
# Local Vite and Capacitor origins are allowed by default; add production site origins here.
CORS_ORIGINS=https://stockly.example.com,https://admin.stockly.example.com

# Bound Admin.gs web-app /exec URL (private admin spreadsheet backend)
ADMIN_SCRIPT_URL=
# Must EXACTLY match the secret passed to setAdminScriptToken() in Admin.gs
ADMIN_SCRIPT_TOKEN=
# One-time owner bootstrap + admin login factor
ADMIN_SETUP_KEY=
# HMAC secret for admin session tokens
ADMIN_SESSION_SECRET=
# Shared with Apps Script USER_SYNC_SECRET for signed status envelopes
ADMIN_MIRROR_SECRET=
# HMAC secret for per-device session tokens
DEVICE_SESSION_SECRET=
# HMAC secret for user auth session tokens
AUTH_SESSION_SECRET=
# Admin session lifetime in hours (default 12, max 72)
ADMIN_SESSION_TTL_HOURS=12
# Budget per Google Apps Script round-trip in ms (default 50000, clamped
# 5000-120000). Keep above the frontends' own timeouts (25-30s).
# STOCKLY_UPSTREAM_TIMEOUT_MS=50000
