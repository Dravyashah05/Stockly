{
  "name": "@stockly/server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Stockly shared backend — one Express process reusing the canonical api/* handlers (same implementation as the Vercel serverless functions).",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test ../../tests/api-response.test.ts ../../tests/releases.test.ts ../../tests/user-registry.test.ts ../../tests/admin-auth.test.ts ../../tests/device-link.test.ts ../../tests/auth.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^24.13.3",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3"
  }
}
