{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:website",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/__stockly_api",
      "destination": "/api/stockly"
    },
    {
      "source": "/app-store",
      "destination": "/store.html"
    }
  ]
}
